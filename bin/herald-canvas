#!/usr/bin/env python
"""Read Canvas and request approved actions without exposing OAuth credentials."""
import argparse, json, os, pathlib, shutil, sys
_EXT = pathlib.Path(__file__).resolve().parents[1]
sys.path.insert(0, str(_EXT / "lib"))
_root = os.environ.get("HERALD_ROOT") or str(pathlib.Path(shutil.which("herald")).resolve().parents[1])
sys.path.insert(0, str(pathlib.Path(_root) / "lib"))
from herald import config, db, red
from canvas_access.auth import AuthRequired, CanvasError
from canvas_access.client import Client


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)
    sub.add_parser("login", help="Open the private browser login view for 15 minutes")
    sub.add_parser("keepalive", help="Renew your browser session, with silent SSO recovery")
    sub.add_parser("status", help="Connection state without displaying credentials")
    sub.add_parser("courses")
    get = sub.add_parser("get")
    get.add_argument("path")
    get.add_argument("--params", default="{}", help="JSON query parameters")
    action = sub.add_parser("request")
    action.add_argument("--payload-file", required=True)
    action.add_argument("--show", action="store_true")
    submit = sub.add_parser("submit")
    submit.add_argument("--course", required=True)
    submit.add_argument("--assignment", required=True)
    content = submit.add_mutually_exclusive_group(required=True)
    content.add_argument("--file", action="append")
    content.add_argument("--text-file")
    content.add_argument("--url")
    submit.add_argument("--show", action="store_true")
    args = parser.parse_args()
    try:
        if args.command == "login":
            from canvas_access.session_login import serve
            serve()
            return 0
        if args.command == "keepalive":
            from canvas_access.browser import keepalive
            value = keepalive()
            print(json.dumps(value))
            return 0
        if args.command == "status":
            with db.session() as con:
                row = con.execute("SELECT data FROM facts WHERE source='canvas' AND kind='status' AND external_id='api'").fetchone()
            saved = (pathlib.Path(config.get("canvas.auth_dir")) / "session.json").exists()
            value = json.loads(row[0]) if row else {"connected": False, "awaiting_first_login": not saved}
            value["authorization_saved"] = saved
        elif args.command == "courses":
            value = Client().catalog()
        elif args.command == "get":
            params = json.loads(args.params)
            if not isinstance(params, dict):
                raise ValueError("Query parameters must be a JSON object")
            value = Client().get(args.path, params)
        elif args.command == "submit":
            from canvas_access.files import prepare_file, file_bytes
            client = Client()
            client.gate("POST", f"/api/v1/courses/{args.course}/assignments/{args.assignment}/submissions")
            payload = {"course_id": args.course, "assignment_id": args.assignment}
            if args.file:
                payload["files"] = [prepare_file(p) for p in args.file]
            elif args.text_file:
                payload["text"] = file_bytes(args.text_file).decode()
            else:
                payload["url"] = args.url
            if args.show:
                print(red.render("canvas.submit", payload))
                return 0
            value = red.run("canvas.submit", payload, actor="canvas:conversation")
        else:
            payload = json.loads(pathlib.Path(args.payload_file).read_text())
            if args.show:
                print(red.render("canvas.request", payload))
                return 0
            value = red.run("canvas.request", payload, actor="canvas:conversation")
        print(json.dumps(value, ensure_ascii=False, indent=2))
        return 0
    except (AuthRequired, CanvasError, PermissionError, ValueError) as exc:
        print(str(exc), file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
