[Unit]
Description=Private Canvas browser login (15 minutes)
After=network-online.target

[Service]
Type=simple
WorkingDirectory={{ROOT}}
ExecStart={{ROOT}}/venv/bin/python {{HOME}}/extensions/canvas/bin/herald-canvas login
Environment=PYTHONUNBUFFERED=1
Environment=HERALD_ROOT={{ROOT}}
UMask=0077
NoNewPrivileges=true
RuntimeMaxSec=20min
